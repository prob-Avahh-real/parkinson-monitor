# CI environment configuration.
#
# This file is committed and copied to `.env` by CI before building.
# All external/cloud services are DISABLED so the app builds and runs
# fully offline (local Hive storage only) without any credentials or
# native config files (e.g. GoogleService-Info.plist on iOS).
#
# Note: never put real secrets here — this file is public.

ENVIRONMENT=production

# Supabase (cloud sync disabled below, placeholders only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Monitoring — disabled
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
FIREBASE_ENABLED=false

# Feature flags — all off for a clean offline build
ENABLE_CLOUD_SYNC=false
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false

# API
API_TIMEOUT=30000
API_RETRY_COUNT=3

# Detection thresholds
FREEZE_INDEX_THRESHOLD=1.8
TREMOR_FREQUENCY_MIN=4.0
TREMOR_FREQUENCY_MAX=6.0
TREMOR_POWER_THRESHOLD=0.3
BRADYKINESIA_AMPLITUDE_THRESHOLD=0.15
BRADYKINESIA_CADENCE_THRESHOLD=40
BRADYKINESIA_ANGULAR_VELOCITY_THRESHOLD=0.3

# Sampling
SENSOR_SAMPLING_RATE=50
DETECTION_WINDOW_SIZE=300
CONFIRMATION_FRAMES=3
DEBOUNCE_DURATION_MS=3000
