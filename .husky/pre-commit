#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Format code
echo "📝 Formatting code..."
dart format --set-exit-if-changed .

# Run analyzer
echo "🔎 Running analyzer..."
flutter analyze

# Run tests
echo "🧪 Running tests..."
flutter test

echo "✅ Pre-commit checks passed!"
