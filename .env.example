# Environment Configuration
ENVIRONMENT=production

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Monitoring Configuration
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
FIREBASE_ENABLED=true

# Feature Flags
ENABLE_CLOUD_SYNC=true
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true

# API Configuration
API_TIMEOUT=30000
API_RETRY_COUNT=3

# Detection Thresholds (default values, can be overridden per user)
FREEZE_INDEX_THRESHOLD=1.8
TREMOR_FREQUENCY_MIN=4.0
TREMOR_FREQUENCY_MAX=6.0
TREMOR_POWER_THRESHOLD=0.3
BRADYKINESIA_AMPLITUDE_THRESHOLD=0.15
BRADYKINESIA_CADENCE_THRESHOLD=40
BRADYKINESIA_ANGULAR_VELOCITY_THRESHOLD=0.3

# Sampling Configuration
SENSOR_SAMPLING_RATE=50
DETECTION_WINDOW_SIZE=300
CONFIRMATION_FRAMES=3
DEBOUNCE_DURATION_MS=3000
